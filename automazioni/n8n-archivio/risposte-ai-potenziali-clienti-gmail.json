    {
      "id": "ba944ab0-fe96-4a12-b00e-353000b0c4ff",
      "name": "Agent 2 – Scrive la risposta",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        800,
        304
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Categoria: {{ $json.output.categoria }}\nCosa cerca davvero: {{ $json.output.cosa_cerca }}\nMittente: {{ $(\"Nuova email\").item.json.from.text }}\nOggetto: {{ $(\"Nuova email\").item.json.subject }}\nEmail ricevuta:\n{{ ($(\"Nuova email\").item.json.text || '').slice(0, 4000) }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "Scrivi la risposta email di Alessandro Mauro a un potenziale cliente. Alessandro realizza per piccole attività e professionisti siti, gestionali, automazioni e \"Video Factory\" (serie di reel su misura). Non chiamare mai i reel \"caroselli\".\nRegole:\n- Italiano corretto, punteggiatura e spazi curati, tono educato, professionale e umano: deve sembrare scritta da una persona vera, non da un'IA.\n- Dai del Lei, salvo che il cliente dia del tu.\n- Rispondi esattamente a quello che chiede. La leva principale è sempre il tempo che il cliente risparmia.\n- Non criticare mai il lavoro attuale del cliente.\n- NON inventare prezzi, tempi, dati, nomi o risultati. Se chiede prezzi o dettagli che non conosci, spiega che dipende dalle sue esigenze e proponi una breve call conoscitiva.\n- Proponi una call conoscitiva quando ha senso.\n- Una sola domanda finale.\n- Breve: massimo 120 parole prima della firma.\n- Non scrivere l'oggetto.\n- Chiudi sempre con questa firma esatta:\nAlessandro Mauro\nTel. / WhatsApp: +39 339 405 2935\nalessandromauro.lovable.app"
            }
          ]
        },
        "batching": {}
      }
    },
