    {
      "id": "d1470635-d2ce-4300-be04-3f4121e118e3",
      "name": "Agent 1 – Classifica",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        224,
        144
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Mittente: {{ $json.from.text }}\nOggetto: {{ $json.subject }}\nTesto email:\n{{ ($json.text || '').slice(0, 4000) }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "Sei l'assistente di Alessandro Mauro, che vende a piccole attività e professionisti (medici, dietisti, ristoranti, centri estetici) siti, gestionali, automazioni e \"Video Factory\" (serie di reel su misura).\nClassifica l'email ricevuta in UNA sola categoria:\n- \"no_grazie\": la persona rifiuta, dice che non è interessata, chiede di non essere ricontattata.\n- \"interessato\": mostra interesse, vuole una call, vuole procedere o sapere i prossimi passi.\n- \"info\": chiede informazioni generali (prezzi, tempi, come funziona, esempi).\n- \"domanda\": fa una domanda specifica su un servizio o sulla sua situazione.\n- \"non_lead\": NON è un potenziale cliente (newsletter, notifiche automatiche, fatture, banche, social, spam, email personali o di lavoro non legate alla vendita).\nNel dubbio tra non_lead e le altre, scegli non_lead.\nIn \"cosa_cerca\" scrivi in una frase cosa vuole davvero la persona. In \"motivo\" spiega brevemente la scelta.\nEsempi: \"No grazie, non ci interessa\" -> no_grazie. \"Quanto costa un sito?\" -> info. \"Il gestionale si collega a Google Calendar?\" -> domanda. \"Sì, sentiamoci giovedì\" -> interessato. \"La tua fattura Vodafone\" -> non_lead."
            }
          ]
        },
        "batching": {}
      }
    },
