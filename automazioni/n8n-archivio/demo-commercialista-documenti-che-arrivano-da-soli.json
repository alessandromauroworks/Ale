        "completionMessage": "={{ \"Il documento è stato archiviato e la pratica risulta completa.\\n\\nAl cliente partirebbe su WhatsApp questa conferma:\\n\\n\" + $(\"Prepara conferma pratica completa\").item.json.conferma }}"
