{
  "name": "Demo Commercialista – Documenti che arrivano da soli",
  "nodes": [
    {
      "id": "b0b65f4b-662e-4959-b3ea-d886b34636f8",
      "name": "1 · Documento ricevuto su WhatsApp",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        96
      ],
      "parameters": {
        "formTitle": "Studio Commercialista Demo · Documento dal cliente",
        "formDescription": "Simula un cliente che manda un documento su WhatsApp allo studio. Dati inventati, solo dimostrativi.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Nome del cliente",
              "fieldName": "cliente",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "Es. Marco Bianchi"
            },
            {
              "fieldLabel": "Documento appena inviato",
              "fieldName": "documento",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Fatture acquisti"
                  },
                  {
                    "option": "Estratto conto"
                  },
                  {
                    "option": "Certificazione Unica"
                  },
                  {
                    "option": "Spese detraibili"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Cosa manca ancora alla pratica",
              "fieldName": "mancante",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Estratto conto"
                  },
                  {
                    "option": "Certificazione Unica"
                  },
                  {
                    "option": "Spese detraibili"
                  },
                  {
                    "option": "Nulla, tutto arrivato"
                  }
                ]
              }
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Invia documento",
          "path": "demo-commercialista-documento"
        }
      },
      "webhookId": "6ccdf63f-50c4-4e43-b8c9-01bcdaa7e7ae"
    },
    {
      "id": "ca22bc5e-75ce-40ab-8010-20bb9db06be1",
      "name": "Archivia nella cartella del cliente",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "nomeBreve",
              "name": "nomeBreve",
              "value": "={{ String($json.cliente).trim().split(\" \")[0] }}",
              "type": "string"
            },
            {
              "id": "cartella",
              "name": "cartella",
              "value": "={{ \"Clienti / \" + String($json.cliente).trim() + \" / Documenti / \" + $json.documento }}",
              "type": "string"
            },
            {
              "id": "manca",
              "name": "manca",
              "value": "={{ $json.mancante !== \"Nulla, tutto arrivato\" }}",
              "type": "boolean"
            }
          ]
        }
      }
    },
    {
      "id": "d70ff1e0-e90b-471f-b8ca-cee6337fe5c2",
      "name": "Manca ancora qualcosa?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.manca }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "d8bd94e4-61d0-4f41-816c-846f24032a32",
      "name": "Prepara promemoria al cliente",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        128
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "promemoria",
              "name": "promemoria",
              "value": "={{ \"Buongiorno \" + $json.nomeBreve + \", abbiamo ricevuto \" + $json.documento + \". Per completare la sua pratica ci manca ancora: \" + $json.mancante + \". Può inviarcelo rispondendo direttamente a questo messaggio. Grazie!\" }}",
              "type": "string"
            },
            {
              "id": "riepilogo",
              "name": "riepilogo",
              "value": "={{ \"DEMO COMMERCIALISTA\\n\\nPasso 1 · Il cliente \" + $json.cliente + \" ha mandato su WhatsApp: \" + $json.documento + \".\\nPasso 2 · Archiviato in automatico in: \" + $json.cartella + \".\\nPasso 3 · Manca ancora: \" + $json.mancante + \". Al cliente partirebbe questo promemoria:\\n\\n\" + \"Buongiorno \" + $json.nomeBreve + \", abbiamo ricevuto \" + $json.documento + \". Per completare la sua pratica ci manca ancora: \" + $json.mancante + \". Può inviarcelo rispondendo direttamente a questo messaggio. Grazie!\" + \"\\n\\nPasso 4 · Pannello scadenze aggiornato: documento ricevuto, 1 documento ancora mancante per \" + $json.cliente + \".\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "c502102f-ea80-483b-a1a6-92f7915a98e4",
      "name": "Anteprima su Telegram (promemoria)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        944,
        128
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "<RIMOSSO>",
        "text": "={{ $json.riepilogo }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      },
      "onError": "continueRegularOutput",
      "webhookId": "f36ef586-787d-4d21-965b-1ccc77aa7542",
      "credentials": {
        "telegramApi": {
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "955d2d47-c56b-472e-b313-dedf4f2dd3f2",
      "name": "Mostra il promemoria",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        1168,
        128
      ],
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "Documento archiviato",
        "completionMessage": "={{ \"Il documento è stato archiviato nella cartella del cliente.\\n\\nAl cliente partirebbe su WhatsApp questo promemoria:\\n\\n\" + $(\"Prepara promemoria al cliente\").item.json.promemoria }}"
      },
      "webhookId": "c4297211-2a2c-4e42-84de-e7e49fa7c7aa"
    },
    {
      "id": "22753e2d-ce40-4356-9d4a-fd6c71e53f84",
      "name": "Prepara conferma pratica completa",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        320
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "conferma",
              "name": "conferma",
              "value": "={{ \"Buongiorno \" + $json.nomeBreve + \", abbiamo ricevuto \" + $json.documento + \": la sua documentazione è completa. Ci pensiamo noi, la avvisiamo appena è tutto pronto.\" }}",
              "type": "string"
            },
            {
              "id": "riepilogo",
              "name": "riepilogo",
              "value": "={{ \"DEMO COMMERCIALISTA\\n\\nPasso 1 · Il cliente \" + $json.cliente + \" ha mandato su WhatsApp: \" + $json.documento + \".\\nPasso 2 · Archiviato in automatico in: \" + $json.cartella + \".\\nPasso 3 · Non manca nulla: nessun promemoria da mandare. Al cliente partirebbe questa conferma:\\n\\n\" + \"Buongiorno \" + $json.nomeBreve + \", abbiamo ricevuto \" + $json.documento + \": la sua documentazione è completa. Ci pensiamo noi, la avvisiamo appena è tutto pronto.\" + \"\\n\\nPasso 4 · Pannello scadenze aggiornato: pratica di \" + $json.cliente + \" con documenti completi, pronta da lavorare.\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
