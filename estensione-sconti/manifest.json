{
  "manifest_version": 3,
  "name": "Cacciasconti",
  "version": "1.4.2",
  "description": "Al momento del pagamento prova i codici sconto per te e applica il migliore. Salva sul tuo computer lo storico dei prezzi dei prodotti che visiti; ti avvisa per quelli che segui. Gmail e condivisione sono spenti di base: tutto resta sul tuo computer.",
  "permissions": [
    "storage",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "domain.js",
      "estrattore.js",
      "lib-extra.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Cacciasconti",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "domain.js",
        "estrattore.js",
        "cercatore.js",
        "tester.js",
        "lib-extra.js",
        "pagina-extra.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "exclude_matches": [
        "https://mail.google.com/*",
        "*://www.google.com/search*",
        "*://www.google.it/search*",
        "*://www.google.fr/search*",
        "*://www.google.de/search*",
        "*://www.google.es/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.nl/search*",
        "*://www.google.ch/search*",
        "*://www.google.at/search*",
        "*://www.google.be/search*",
        "*://www.google.pt/search*",
        "*://www.google.pl/search*",
        "*://www.google.ie/search*",
        "*://www.google.ca/search*",
        "*://www.google.com.au/search*"
      ]
    },
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.it/search*",
        "*://www.google.fr/search*",
        "*://www.google.de/search*",
        "*://www.google.es/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.nl/search*",
        "*://www.google.ch/search*",
        "*://www.google.at/search*",
        "*://www.google.be/search*",
        "*://www.google.pt/search*",
        "*://www.google.pl/search*",
        "*://www.google.ie/search*",
        "*://www.google.ca/search*",
        "*://www.google.com.au/search*"
      ],
      "js": [
        "domain.js",
        "google.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "domain.js",
        "estrattore.js",
        "lib-extra.js",
        "gmail.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cacciasconti@alessandro.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "browsingActivity",
          "authenticationInfo"
        ]
      }
    }
  }
}
