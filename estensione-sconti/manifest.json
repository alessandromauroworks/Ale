{
  "manifest_version": 3,
  "name": "Cacciasconti",
  "version": "1.0.0",
  "description": "Al momento del pagamento prova i codici sconto per te e applica il migliore. Tutto resta sul tuo computer.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Cacciasconti",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["domain.js", "cercatore.js", "tester.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
