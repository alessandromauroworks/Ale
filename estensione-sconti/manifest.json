{
  "manifest_version": 3,
  "name": "Cacciasconti",
  "version": "1.2.0",
  "description": "Al momento del pagamento prova i codici sconto per te e applica il migliore. Tutto resta sul tuo computer.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "domain.js",
      "estrattore.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Cacciasconti",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "domain.js",
        "estrattore.js",
        "cercatore.js",
        "tester.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cacciasconti@alessandro.local",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "browsingActivity"
        ]
      }
    }
  }
}
