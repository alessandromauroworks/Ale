# Copia questo file con il nome ".env" (senza "esempio") e compila i campi.
# Il file .env e' segreto: resta solo sul tuo PC.

# Indirizzo del progetto Supabase (gia' giusto)
SUPABASE_URL=https://udubhzamghhlkxgepmmc.supabase.co

# Chiave service_role (SEGRETA). Supabase -> Project Settings -> API Keys.
# Non incollarla mai in chat.
SUPABASE_SERVICE_KEY=

# Cartella dove Analizza salva i report. Se la lasci vuota la cerco io
# (Desktop\Lavoro IA\Analisi\Reel, anche sotto OneDrive).
CARTELLA_REPORT=

# Dove risponde Analizza
ANALIZZA_URL=http://localhost:8765

# Percorso di AVVIA.bat di Analizza (se vuoto lo cerco in Desktop\Lavoro IA\App\Analizza)
ANALIZZA_AVVIO=

# Facoltativo: comando da eseguire per analizzare un link. Usa {link} al posto del link.
# Esempio: COMANDO_ANALISI=python C:\percorso\analizza_cli.py {link}
# Se e' vuoto uso la funzione avvia_analisi dello script.
COMANDO_ANALISI=

# Ogni quanti secondi controllo la coda
ATTESA_SECONDI=30

# Dopo quanti minuti rinuncio ad aspettare il report
TEMPO_MAX_MINUTI=20
